# ---------------------------------------------------------------------
# RAVANTRA — environment variables
# Copy to .env.local for local dev. On Vercel add them in
# Project → Settings → Environment Variables.
#
# With NO variables set the app runs in "preview mode": the storefront
# and admin render the bundled demo data (read-only).
# ---------------------------------------------------------------------

# Public site URL (used for SEO, sitemap, auth email redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) -------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# "anon" / "publishable" key — safe for the browser (RLS protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" / "secret" key — SERVER ONLY. Used for payment
# verification, webhooks and refunds. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay (Dashboard → Account & Settings → API Keys) ------------
# Use test-mode keys (rzp_test_...) until you go live.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → secret for /api/payments/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=

# When Razorpay keys are absent, allow a clearly-labelled simulated
# payment so the full order flow can be demonstrated. Set to "false"
# in production once Razorpay is configured.
DEMO_PAYMENTS=true

# --- Resend (transactional email, optional) --------------------------
RESEND_API_KEY=
EMAIL_FROM="RAVANTRA <onboarding@resend.dev>"

# --- WhatsApp click-to-chat number (country code, digits only) -------
NEXT_PUBLIC_WHATSAPP_NUMBER=919000000000

# --- Vercel Cron secret (protects /api/cron/expire-orders) -----------
CRON_SECRET=
