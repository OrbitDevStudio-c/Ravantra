# ---------------------------------------------------------------------
# RAVANTRA — environment variables
# Copy to .env.local for local dev. On Vercel add them in
# Project → Settings → Environment Variables.
#
# With NO database configured the app runs in "preview mode": the storefront
# and admin render the bundled demo data (read-only).
# ---------------------------------------------------------------------

# Public site URL (used for SEO, sitemap, password-reset links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database: Neon Postgres (Neon console → Connection string) -------
# SERVER ONLY — never prefix with NEXT_PUBLIC_. Use the pooled connection
# string. `Database_Storage` is also accepted as an alias.
DATABASE_URL=

# First super admin — created/updated by `npm run db:setup`
# (the password is stored bcrypt-hashed in the database, never in code).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- AI assistant (admin only) — OpenRouter (openrouter.ai/keys) ------
OPENROUTER_API_KEY=
# Any OpenRouter model id, e.g. openai/gpt-4o-mini
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini

# --- Razorpay (Dashboard → Account & Settings → API Keys) ------------
# Use test-mode keys (rzp_test_...) until you go live.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → secret for /api/payments/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=

# When Razorpay keys are absent, allow a clearly-labelled simulated
# payment so the full order flow can be demonstrated. Set to "false"
# in production once Razorpay is configured.
DEMO_PAYMENTS=true

# --- Resend (transactional email, optional) --------------------------
RESEND_API_KEY=
EMAIL_FROM="RAVANTRA <onboarding@resend.dev>"

# --- WhatsApp click-to-chat number (country code, digits only) -------
NEXT_PUBLIC_WHATSAPP_NUMBER=919000000000

# --- Vercel Cron secret (protects /api/cron/expire-orders) -----------
CRON_SECRET=
