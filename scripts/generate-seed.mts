/**
 * Generates supabase/seed.sql from src/config/demo-data.ts
 * Run: npm run db:seed:generate
 */
import { writeFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { dirname, join } from "node:path";
import {
  adminUsers,
  categories,
  coupons,
  DEMO_PASSWORD,
  demoAppointments,
  demoCustomers,
  demoOrders,
  DIVISION_IDS,
  divisions,
  newsletterDemo,
  permissions,
  productAgeDays,
  products,
  promotions,
  reviewAgeDays,
  reviews,
  roles,
  services,
  stylists,
  u,
} from "../src/config/demo-data.ts";

const q = (v: string | null | undefined) => (v == null ? "null" : `'${String(v).replace(/'/g, "''")}'`);
const n = (v: number | null | undefined) => (v == null ? "null" : String(v));
const b = (v: boolean) => (v ? "true" : "false");
const arr = (xs: string[]) => (xs.length ? `array[${xs.map(q).join(",")}]::text[]` : "'{}'::text[]");
const ago = (days: number, hours = 0) => `now() - interval '${days} days ${hours} hours'`;

const out: string[] = [];
const emit = (s: string) => out.push(s);

emit(`-- =====================================================================
-- RAVANTRA — DEMO SEED DATA (generated by scripts/generate-seed.ts)
-- All people, orders, reviews and appointments below are FICTIONAL and
-- flagged with is_demo = true. Do not edit by hand — edit
-- src/config/demo-data.ts and run \`npm run db:seed:generate\`.
--
-- Demo password for every seeded account: ${DEMO_PASSWORD}
-- =====================================================================
begin;
`);

/* ---------------- divisions ---------------- */
emit(`-- Business divisions`);
for (const d of divisions) {
  emit(
    `insert into public.business_divisions (id, slug, name, short_name, tagline, description, kind, accent_color, hero_image, banner_image, logo_url, sort_order, is_active) values (${q(d.id)}, ${q(d.slug)}, ${q(d.name)}, ${q(d.shortName)}, ${q(d.tagline)}, ${q(d.description)}, ${q(d.kind)}, ${q(d.accentColor)}, ${q(d.heroImage)}, ${q(d.bannerImage)}, ${q(d.logoUrl)}, ${d.sortOrder}, ${b(d.isActive)}) on conflict (id) do nothing;`,
  );
}

/* ---------------- roles & permissions ---------------- */
emit(`\n-- Permissions & roles`);
permissions.forEach(([key, desc], i) => {
  emit(`insert into public.permissions (id, key, description) values (${q(u(16, i + 1))}, ${q(key)}, ${q(desc)}) on conflict (key) do nothing;`);
});
roles.forEach((r, i) => {
  const division = r.division ? q(DIVISION_IDS[r.division]) : "null";
  emit(`insert into public.roles (id, key, name, division_id, is_system) values (${q(u(15, i + 1))}, ${q(r.key)}, ${q(r.name)}, ${division}, true) on conflict (key) do nothing;`);
  const keys = r.perms === "*" ? permissions.map((p) => p[0]) : r.perms;
  for (const k of keys) {
    emit(`insert into public.role_permissions (role_id, permission_id) select r.id, p.id from public.roles r, public.permissions p where r.key = ${q(r.key)} and p.key = ${q(k)} on conflict do nothing;`);
  }
});

/* ---------------- catalogue ---------------- */
emit(`\n-- Categories`);
for (const c of categories) {
  emit(
    `insert into public.categories (id, division_id, slug, name, description, image, sort_order, is_featured) values (${q(c.id)}, ${q(c.divisionId)}, ${q(c.slug)}, ${q(c.name)}, ${q(c.description)}, ${q(c.image)}, ${c.sortOrder}, ${b(c.isFeatured)}) on conflict (id) do nothing;`,
  );
}

emit(`\n-- Products, images, variants`);
for (const p of products) {
  emit(
    `insert into public.products (id, division_id, category_id, slug, name, sku, short_description, description, price, sale_price, ingredients, highlights, tags, is_featured, is_new, is_active, created_at) values (${q(p.id)}, ${q(p.divisionId)}, ${q(p.categoryId)}, ${q(p.slug)}, ${q(p.name)}, ${q(p.sku)}, ${q(p.shortDescription)}, ${q(p.description)}, ${n(p.price)}, ${n(p.salePrice)}, ${q(p.ingredients)}, ${arr(p.highlights)}, ${arr(p.tags)}, ${b(p.isFeatured)}, ${b(p.isNew)}, true, ${ago(productAgeDays[p.id] ?? 30)}) on conflict (id) do nothing;`,
  );
  for (const im of p.images) {
    emit(`insert into public.product_images (id, product_id, url, alt, sort_order) values (${q(im.id)}, ${q(p.id)}, ${q(im.url)}, ${q(im.alt)}, ${im.sortOrder}) on conflict (id) do nothing;`);
  }
  p.variants.forEach((v, vi) => {
    emit(
      `insert into public.product_variants (id, product_id, sku, name, size, color, color_hex, volume, price, sale_price, sort_order) values (${q(v.id)}, ${q(p.id)}, ${q(v.sku)}, ${q(v.name)}, ${q(v.size)}, ${q(v.color)}, ${q(v.colorHex)}, ${q(v.volume)}, ${n(v.price)}, ${n(v.salePrice)}, ${vi}) on conflict (id) do nothing;`,
    );
  });
}

emit(`\n-- Opening stock (inventory rows are created by trigger; quantities set here with an audit trail)`);
emit(`select set_config('ravantra.inventory_write', 'on', true);`);
for (const p of products) {
  for (const v of p.variants) {
    emit(`update public.inventory set quantity = ${v.stock} where variant_id = ${q(v.id)} and quantity = 0;`);
    emit(`insert into public.inventory_movements (variant_id, change, quantity_after, reason, note, created_at) select ${q(v.id)}, ${v.stock}, ${v.stock}, 'initial', 'Opening stock (demo)', ${ago((productAgeDays[p.id] ?? 30))} where ${v.stock} > 0 and not exists (select 1 from public.inventory_movements m where m.variant_id = ${q(v.id)} and m.reason = 'initial');`);
  }
}
emit(`select set_config('ravantra.inventory_write', 'off', true);`);

/* ---------------- salon ---------------- */
emit(`\n-- Salon & Spa services, stylists, availability`);
for (const s of services) {
  emit(
    `insert into public.services (id, division_id, slug, category, name, description, duration_min, price, image, is_popular, is_active) values (${q(s.id)}, ${q(DIVISION_IDS.salon)}, ${q(s.slug)}, ${q(s.category)}, ${q(s.name)}, ${q(s.description)}, ${s.durationMin}, ${s.price}, ${q(s.image)}, ${b(s.isPopular)}, true) on conflict (id) do nothing;`,
  );
}
for (const st of stylists) {
  emit(
    `insert into public.stylists (id, division_id, slug, name, title, bio, image, specialties, experience_years, is_active) values (${q(st.id)}, ${q(DIVISION_IDS.salon)}, ${q(st.slug)}, ${q(st.name)}, ${q(st.title)}, ${q(st.bio)}, ${q(st.image)}, ${arr(st.specialties)}, ${st.experienceYears}, true) on conflict (id) do nothing;`,
  );
  for (const sid of st.serviceIds) {
    emit(`insert into public.stylist_services (stylist_id, service_id) values (${q(st.id)}, ${q(sid)}) on conflict do nothing;`);
  }
  for (const wh of st.workingHours) {
    emit(`insert into public.working_hours (stylist_id, weekday, start_time, end_time) values (${q(st.id)}, ${wh.weekday}, ${q(wh.startTime)}, ${q(wh.endTime)}) on conflict (stylist_id, weekday) do nothing;`);
  }
}
emit(`-- A blocked slot: staff training next Wednesday afternoon (Asia/Kolkata)`);
emit(
  `insert into public.blocked_slots (stylist_id, starts_at, ends_at, reason) select ${q(stylists[0].id)}, (x.d + time '15:00') at time zone 'Asia/Kolkata', (x.d + time '17:00') at time zone 'Asia/Kolkata', 'Team training (demo)' from (select (now() at time zone 'Asia/Kolkata')::date + ((9 - extract(dow from (now() at time zone 'Asia/Kolkata'))::int) % 7 + 1) as d) x where not exists (select 1 from public.blocked_slots where reason = 'Team training (demo)');`,
);

/* ---------------- marketing ---------------- */
emit(`\n-- Promotions & coupons`);
for (const p of promotions) {
  emit(
    `insert into public.promotions (id, eyebrow, title, subtitle, cta_label, cta_href, image, placement, division_id, is_active, sort_order) values (${q(p.id)}, ${q(p.eyebrow)}, ${q(p.title)}, ${q(p.subtitle)}, ${q(p.ctaLabel)}, ${q(p.ctaHref)}, ${q(p.image)}, ${q(p.placement)}, ${q(p.divisionId)}, ${b(p.isActive)}, ${p.sortOrder}) on conflict (id) do nothing;`,
  );
}
for (const c of coupons) {
  emit(
    `insert into public.coupons (id, code, description, discount_type, discount_value, min_subtotal, max_discount, division_id, usage_limit, is_active) values (${q(c.id)}, ${q(c.code)}, ${q(c.description)}, ${q(c.discountType)}, ${c.discountValue}, ${c.minSubtotal}, ${n(c.maxDiscount)}, ${q(c.divisionId)}, ${n(c.usageLimit)}, ${b(c.isActive)}) on conflict (id) do nothing;`,
  );
}
newsletterDemo.forEach((email, i) => {
  emit(`insert into public.newsletter_subscribers (email, source, is_demo, created_at) values (${q(email)}, 'demo', true, ${ago(30 - i * 9)}) on conflict do nothing;`);
});

/* ---------------- auth users ---------------- */
emit(`\n-- Demo auth users (password: ${DEMO_PASSWORD}). Profiles + customer role are created by trigger.`);
const allUsers = [
  ...adminUsers.map((a) => ({ id: a.id, email: a.email, name: a.name, phone: null as string | null, joined: 240 })),
  ...demoCustomers.map((c) => ({ id: c.id, email: c.email, name: c.fullName, phone: c.phone, joined: c.joinedDaysAgo })),
];
for (const usr of allUsers) {
  const meta = JSON.stringify({ full_name: usr.name, phone: usr.phone, demo: true });
  emit(
    `insert into auth.users (instance_id, id, aud, role, email, encrypted_password, email_confirmed_at, raw_app_meta_data, raw_user_meta_data, created_at, updated_at, confirmation_token, email_change, email_change_token_new, recovery_token) values ('00000000-0000-0000-0000-000000000000', ${q(usr.id)}, 'authenticated', 'authenticated', ${q(usr.email)}, extensions.crypt(${q(DEMO_PASSWORD)}, extensions.gen_salt('bf')), now(), '{"provider":"email","providers":["email"]}'::jsonb, ${q(meta)}::jsonb, ${ago(usr.joined)}, now(), '', '', '', '') on conflict (id) do nothing;`,
  );
  emit(
    `insert into auth.identities (id, user_id, provider_id, identity_data, provider, last_sign_in_at, created_at, updated_at) values (${q(usr.id)}, ${q(usr.id)}, ${q(usr.id)}, ${q(JSON.stringify({ sub: usr.id, email: usr.email, email_verified: true }))}::jsonb, 'email', now(), now(), now()) on conflict do nothing;`,
  );
  emit(`update public.profiles set is_demo = true, phone = ${q(usr.phone)}, created_at = ${ago(usr.joined)} where id = ${q(usr.id)};`);
}

emit(`\n-- Staff roles`);
for (const a of adminUsers) {
  emit(`delete from public.user_roles where user_id = ${q(a.id)} and role_id = (select id from public.roles where key = 'customer');`);
  emit(`insert into public.user_roles (user_id, role_id) select ${q(a.id)}, id from public.roles where key = ${q(a.role)} on conflict do nothing;`);
  const role = roles.find((r) => r.key === a.role);
  if (role?.division) {
    emit(`insert into public.division_managers (division_id, user_id, title) values (${q(DIVISION_IDS[role.division])}, ${q(a.id)}, ${q(role.name)}) on conflict do nothing;`);
  }
}

emit(`\n-- Customer addresses`);
for (const c of demoCustomers) {
  const a = c.address;
  emit(
    `insert into public.addresses (id, user_id, label, full_name, phone, line1, line2, city, state, postal_code, country, is_default) values (${q(a.id)}, ${q(c.id)}, ${q(a.label)}, ${q(a.fullName)}, ${q(a.phone)}, ${q(a.line1)}, null, ${q(a.city)}, ${q(a.state)}, ${q(a.postalCode)}, 'India', true) on conflict (id) do nothing;`,
  );
}

/* ---------------- reviews ---------------- */
emit(`\n-- Demo reviews (flagged is_demo)`);
for (const r of reviews) {
  emit(
    `insert into public.reviews (id, product_id, author_name, rating, title, body, is_demo, created_at) values (${q(r.id)}, ${q(r.productId)}, ${q(r.authorName)}, ${r.rating}, ${q(r.title)}, ${q(r.body)}, true, ${ago(reviewAgeDays[r.id] ?? 10)}) on conflict (id) do nothing;`,
  );
}

/* ---------------- orders ---------------- */
emit(`\n-- Demo orders (historical; inserted directly, flagged is_demo)`);
const productById = new Map(products.map((p) => [p.id, p]));
for (const o of demoOrders) {
  const c = demoCustomers[o.customerIndex];
  const addr = {
    full_name: c.address.fullName,
    phone: c.address.phone,
    line1: c.address.line1,
    line2: null,
    city: c.address.city,
    state: c.address.state,
    postal_code: c.address.postalCode,
    country: "India",
  };
  const created = ago(o.daysAgo, o.hour);
  emit(
    `insert into public.orders (id, order_number, user_id, customer_name, customer_email, customer_phone, status, payment_status, subtotal, discount_total, shipping_total, total, coupon_code, shipping_address, stock_released, is_demo, created_at) values (${q(o.id)}, ${q(o.orderNumber)}, ${q(c.id)}, ${q(c.fullName)}, ${q(c.email)}, ${q(c.phone)}, ${q(o.status)}, ${q(o.paymentStatus)}, ${o.subtotal}, ${o.discount}, ${o.shipping}, ${o.total}, ${q(o.couponCode)}, ${q(JSON.stringify(addr))}::jsonb, true, true, ${created}) on conflict (id) do nothing;`,
  );
  for (const it of o.items) {
    const p = productById.get(it.productId)!;
    const v = p.variants.find((x) => x.id === it.variantId)!;
    emit(
      `insert into public.order_items (id, order_id, product_id, variant_id, division_id, product_name, variant_name, sku, image, unit_price, quantity, line_total, created_at) values (${q(it.id)}, ${q(o.id)}, ${q(p.id)}, ${q(v.id)}, ${q(p.divisionId)}, ${q(p.name)}, ${q(v.name)}, ${q(v.sku)}, ${q(p.images[0]?.url ?? null)}, ${it.unitPrice}, ${it.quantity}, ${it.unitPrice * it.quantity}, ${created}) on conflict (id) do nothing;`,
    );
  }
  emit(
    `insert into public.payments (order_id, provider, provider_order_id, provider_payment_id, amount, status, method, created_at) select ${q(o.id)}, 'demo', ${q(`demo_order_${o.orderNumber}`)}, ${o.paymentStatus === "successful" || o.paymentStatus === "refunded" ? q(`demo_pay_${o.orderNumber}`) : "null"}, ${o.total}, ${q(o.paymentStatus)}, 'demo', ${created} where not exists (select 1 from public.payments where order_id = ${q(o.id)});`,
  );
  emit(`insert into public.order_status_history (order_id, status, note, created_at) select ${q(o.id)}, 'pending', 'Order placed (demo)', ${created} where not exists (select 1 from public.order_status_history where order_id = ${q(o.id)});`);
  if (o.status !== "pending") {
    emit(`insert into public.order_status_history (order_id, status, note, created_at) select ${q(o.id)}, ${q(o.status)}, 'Status (demo)', ${ago(Math.max(0, o.daysAgo - 1), o.hour)} where (select count(*) from public.order_status_history where order_id = ${q(o.id)}) = 1;`);
  }
}

/* ---------------- appointments ---------------- */
emit(`\n-- Demo appointments (Asia/Kolkata local times, flagged is_demo)`);
for (const a of demoAppointments) {
  const c = demoCustomers[a.customerIndex];
  const startExpr = `(((now() at time zone 'Asia/Kolkata')::date + ${a.dayOffset}) + time '${a.startTime}') at time zone 'Asia/Kolkata'`;
  emit(
    `insert into public.appointments (id, reference, customer_id, customer_name, customer_email, customer_phone, service_id, stylist_id, starts_at, ends_at, status, price, is_demo, created_at) values (${q(a.id)}, ${q(a.reference)}, ${q(c.id)}, ${q(c.fullName)}, ${q(c.email)}, ${q(c.phone)}, ${q(a.serviceId)}, ${q(a.stylistId)}, ${startExpr}, ${startExpr} + interval '${a.durationMin} minutes', ${q(a.status)}, ${a.price}, true, ${startExpr} - interval '5 days') on conflict (id) do nothing;`,
  );
}

/* ---------------- activity ---------------- */
emit(`\n-- A few activity log entries so the admin feed is not empty`);
const acts: [string, string, string, number][] = [
  ["product.created", "product", "Added Crystal Tennis Bracelet to Lifestyle (demo)", 2],
  ["product.created", "product", "Added Petal Ruffle Organza Blouse to Fashion (demo)", 3],
  ["promotion.updated", "promotion", "Updated The Festive Edit campaign (demo)", 4],
  ["inventory.adjusted", "product_variant", "Restocked Sienna Linen Shirt Dress (demo)", 5],
];
acts.forEach(([action, entity, summary, days], i) => {
  emit(`insert into public.activity_logs (id, actor_id, action, entity_type, summary, created_at) values (${q(u(20, i + 1))}, ${q(adminUsers[0].id)}, ${q(action)}, ${q(entity)}, ${q(summary)}, ${ago(days)}) on conflict (id) do nothing;`);
});

emit(`\n-- keep the order number sequence ahead of demo data
select setval('public.order_number_seq', greatest((select last_value from public.order_number_seq), 10001));

commit;
`);

const here = dirname(fileURLToPath(import.meta.url));
const target = join(here, "..", "supabase", "seed.sql");
writeFileSync(target, out.join("\n"), "utf8");
console.log(`seed.sql written: ${out.length} statements → ${target}`);
